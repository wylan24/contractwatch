    "ignore": {
      "description": "Operations to skip: `/path/*` matches one segment, `/path/**` any depth, optionally prefixed by a method.",
      "type": "array",
      "items": {
        "type": "string",
        "examples": [
          "/internal/**",
          "DELETE /admin/*"
        ]
      }
    },
    "accept": {
      "description": "Breaking changes made on purpose. They are still reported, with the reason, but don't fail the check.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "description": "Change id, as shown in the report.",
            "type": "string",
            "pattern": "^[0-9a-f]{8}$"
          },
          "reason": {
            "description": "Why this break is intended. Shown in the report.",
            "type": "string",
            "minLength": 1
          },
          "expires": {
            "description": "After this date (YYYY-MM-DD) the acceptance no longer applies.",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "allowBreakingOnMajorBump": {
      "description": "Breaking changes pass when info.version gets a new major version (or a new minor version in 0.x).",
      "type": "boolean"
    }
